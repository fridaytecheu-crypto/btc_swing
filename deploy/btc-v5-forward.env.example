# /etc/btc-v5-forward.env — environment for the BTC V5 forward observation services (no secrets needed)
BTC_DATA_DIR=/var/lib/btc_swing
PYTHONUNBUFFERED=1
# Optional outbound proxy (leave empty when the host has direct access to stream.bybit.com / public.bybit.com)
#HTTPS_PROXY=
# Health thresholds
HEALTH_STALE_SECONDS=120
HEALTH_BAR_STALE_SECONDS=900
HEALTH_MIN_FREE_GB=5
# Alert command for the health failure hook (reads the status text on stdin)
ALERT_CMD=logger -t btc-v5-forward-alert
