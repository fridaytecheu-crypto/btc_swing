<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- BTC V10 LIVE MICROSTRUCTURE SNIPER forward runner (own public feed, own raw store, shadow until the
     owner's STRATEGY_DEMO_V10_ACTIVATED event). Rendered by deploy/macos/install_v10_macos.sh. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.btcswing.v10-forward</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/deploy/macos/run_forward_v10.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BTC_DATA_DIR</key><string>__DATA__</string>
    <key>BTC_SWING_REPO</key><string>__REPO__</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ExitTimeOut</key><integer>90</integer>
  <key>ProcessType</key><string>Standard</string>
  <key>StandardOutPath</key><string>__DATA__/btc/forward_v10/logs/launchd.v10.out.log</string>
  <key>StandardErrorPath</key><string>__DATA__/btc/forward_v10/logs/launchd.v10.err.log</string>
</dict>
</plist>
